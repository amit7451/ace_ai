# ═════════════════════════════════════════════════════════════════════
# IonAI Platform — Authoritative Environment Configuration
# ═════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────
# 1. Core Server & Security [REQUIRED]
# ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:3001
LOG_LEVEL=info

# PostgreSQL Connection (Prisma)
DATABASE_URL=postgresql://ion_user:ion_password@localhost:5432/ion_ai?schema=public

# Security Secrets (Must be min 32 chars / 64 hex chars)
JWT_SECRET=replace_with_a_secure_random_32_char_jwt_secret_key_here
ENCRYPTION_KEY=replace_with_64_hex_chars__run__node_-e_"console.log(require('crypto').randomBytes(32).toString('hex'))"
OLD_ENCRYPTION_KEY=

# ─────────────────────────────────────────────────────────────────────
# 2. Redis Cache, Queues & Concurrency [REQUIRED for Workers]
# ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
WORKER_INGESTION_CONCURRENCY=5
WORKER_CRAWLER_CONCURRENCY=2

# ─────────────────────────────────────────────────────────────────────
# 3. Vector Database (Qdrant) [REQUIRED for Vector Search]
# ─────────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ─────────────────────────────────────────────────────────────────────
# 4. Storage — Cloudflare R2 / AWS S3 [OPTIONAL in dev, REQUIRED in prod]
# ─────────────────────────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=ion-ai-knowledge

# ─────────────────────────────────────────────────────────────────────
# 5. Global Free-Tier AI Provider Keys [OPTIONAL / FALLBACK]
# ─────────────────────────────────────────────────────────────────────
# Google Gemini (Default system free-tier provider)
GEMINI_API_KEY=

# Optional platform fallback keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
COHERE_API_KEY=

# ─────────────────────────────────────────────────────────────────────
# 6. Default AI Models & Strategies
# ─────────────────────────────────────────────────────────────────────
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001

# ─────────────────────────────────────────────────────────────────────
# 7. AI Budget Protection & Cost Guardrails [CONFIGURABLE]
# ─────────────────────────────────────────────────────────────────────
# Maximum character length per chat message (prevents excessive prompt tokens)
MAX_MESSAGE_CHARACTERS=4000

# Daily free-tier request quota per organization (prevents budget exhaustion)
DAILY_FREE_TIER_REQUEST_LIMIT=100

# Rate limits (Requests per minute)
GLOBAL_SHARED_KEY_RPM_LIMIT=2000
ORGANIZATION_FREE_TIER_RPM_LIMIT=500
VISITOR_RPM_LIMIT=20
WIDGET_RPM_LIMIT=100

# Free-tier token and chunk depth caps
MAX_FREE_TIER_OUTPUT_TOKENS=1024
MAX_FREE_TIER_TOP_K=5
MAX_CONTEXT_TOKENS=4096

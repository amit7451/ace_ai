# ─────────────────────────────────────────────
# Server & Database Core Environment Variables
# ─────────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database (Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ion_ai?schema=public

# Security Secrets (Must be at least 32 characters)
JWT_SECRET=replace_with_a_secure_random_32_char_jwt_secret_key_here
ENCRYPTION_KEY=replace_with_64_hex_chars__run__node_-e_"console.log(require('crypto').randomBytes(32).toString('hex'))"

# Redis Queue & Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─────────────────────────────────────────────
# AI Providers & Global Defaults
# ─────────────────────────────────────────────

# Default LLM Provider & Model for Testing Tier / Global Server Fallback
# Options: gemini | openai | anthropic | groq | openrouter | ollama
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

# Google Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_BASE_URL=

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_ORG_ID=
OPENAI_BASE_URL=

# Anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# Groq — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=

# Ollama — Local inference, no API key required
OLLAMA_BASE_URL=http://localhost:11434

# Resilience Defaults
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=3

# ─────────────────────────────────────────────
# Embedding Provider Layer
# ─────────────────────────────────────────────
# Options: gemini | openai | cohere | ollama
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
COHERE_API_KEY=

# ─────────────────────────────────────────────
# Vector Store Layer — Qdrant
# ─────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ─────────────────────────────────────────────
# Knowledge Chunking & RAG Retrieval
# ─────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64
RETRIEVER_TOP_K=5
RETRIEVER_SCORE_THRESHOLD=0.5
RETRIEVER_STRATEGY=similarity-threshold
RETRIEVER_MAX_CONTEXT_TOKENS=4096
PROMPT_FALLBACK_STRATEGY=instruct_llm
PROMPT_MAX_HISTORY_MESSAGES=10
MEMORY_PROVIDER=in-memory
MEMORY_TTL_SECONDS=3600

# ─────────────────────────────────────────────
# Cloudflare R2 Document Storage
# ─────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_BUCKET_NAME=ion-ai-knowledge
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
